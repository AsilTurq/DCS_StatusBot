# ==============================================================================
# DCS_StatusBot — SECURITY & TOKEN TEMPLATE (.env.example)
# ==============================================================================
# [EN] ENGLISH INSTRUCTIONS:
#   1. Copy or rename this file to ".env" (or simply run "run.bat" and use the GUI).
#   2. Paste your Discord Bot Tokens obtained from https://discord.com/developers/applications
#   3. Note: ".env" is locked to your Windows user account (ACL) and ignored by Git.
#
# [TR] TÜRKÇE KULLANIM KILAVUZU:
#   1. Bu dosyanın adını ".env" yapın (veya doğrudan "run.bat" çalıştırıp GUI üzerinden girin).
#   2. https://discord.com/developers/applications adresinden aldığınız Bot Token'larını yapıştırın.
#   3. Not: ".env" dosyası Windows kullanıcı hesabınıza kilitlenir ve Git tarafından yoksayılır.
# ==============================================================================

# [EN] Bot #1 Token (DCS Server #1 Status Bot — e.g. Syria Map 0/60)
# [TR] 1. Bot Token (1. DCS Sunucu Durum Botu — Örn: Suriye Haritası 0/60)
SERVER_BOT_TOKEN=PASTE_YOUR_BOT_1_TOKEN_HERE

# [EN] Bot #2 Token (DCS Server #2 Status Bot OR Discord Member Count Bot)
# [TR] 2. Bot Token (2. DCS Sunucu Durum Botu VEYA Discord Üye Sayısı Botu)
MEMBER_BOT_TOKEN=PASTE_YOUR_BOT_2_TOKEN_HERE

# [EN] Bot #3 Token (Optional — DCS Server #3 Status Bot — e.g. Persian Gulf 0/15)
# [TR] 3. Bot Token (Opsiyonel — 3. DCS Sunucu Durum Botu — Örn: İran Haritası 0/15)
THIRD_BOT_TOKEN=PASTE_YOUR_BOT_3_TOKEN_HERE

# [EN] Bot #4 Token (Optional — DCS Server #4 Status Bot — e.g. Sinai Map 0/32)
# [TR] 4. Bot Token (Opsiyonel — 4. DCS Sunucu Durum Botu — Örn: Sina Haritası 0/32)
FOURTH_BOT_TOKEN=PASTE_YOUR_BOT_4_TOKEN_HERE

# [EN] Bot #5 Token (Optional — DCS Server #5 Status Bot OR Member Count Bot)
# [TR] 5. Bot Token (Opsiyonel — 5. DCS Sunucu Durum Botu VEYA Üye Sayısı Botu)
FIFTH_BOT_TOKEN=PASTE_YOUR_BOT_5_TOKEN_HERE

# [EN] Remote Server (VDS) UDP Authentication Secret Key (Auto-generated if left empty)
# [TR] Uzak Sunucu (VDS) UDP Doğrulama Güvenlik Anahtarı (Boş bırakılırsa otomatik üretilir)
REMOTE_SECRET_KEY=PASTE_YOUR_SECRET_KEY_HERE
